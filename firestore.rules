rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Todos los dispositivos entran con sesión anónima de Firebase.
    match /combates/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      // Solo la mesa central que creó el combate puede modificarlo.
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // Puntajes de cada juez de línea (1 a 5).
      match /jueces/{n} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && n in ['1','2','3','4','5']
          && get(/databases/$(db)/documents/combates/$(code)).data.phase in ['listo','combate','revision'];
      }
    }
  }
}
